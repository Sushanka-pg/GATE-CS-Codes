#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node * link;
};

struct node * insert_begin(struct node * ptr, int data){
    struct node * temp = malloc(sizeof(struct node));
    temp->data = data;
    temp->link = ptr->link;
    ptr->link = temp;
    return ptr;
}

struct node * insert_end(struct node * ptr,int data){
    struct node * temp = malloc(sizeof(struct node));
    temp->data = data;
    temp-> link = ptr->link;
    ptr->link = temp;
    ptr=ptr->link;
    return ptr;
}

struct node * insert_at_k(struct node * ptr, int data,int pos){
    struct node * temp = malloc(sizeof(struct node));
    temp->data = data;
    int count =1;
    struct node * p = ptr;
    do{
        p = p->link;
    }while(p!=ptr->link && count < pos+1);
    temp->link = p->link;
    p->link = temp;

    return ptr;
}



int main() {
    struct node * tail = malloc(sizeof(struct node));
    tail->data = 10;
    tail->link = tail;

    tail = insert_begin(tail,20);
    tail = insert_begin(tail,30);

    tail = insert_end(tail,40);

    tail = insert_at_k(tail, 50,1);

    struct node * p = tail->link;
    do{
        printf("%d\n",p->data);
        p=p->link;
    }while(p!=tail->link);

    return 0;
}
