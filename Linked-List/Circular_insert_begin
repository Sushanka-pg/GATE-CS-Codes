// Online C compiler to run C program online
#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node * link;
};

struct node * insert_begin(struct node * ptr,int data){
    struct node * temp = malloc(sizeof(struct node));
    temp->data = data;
    temp->link = ptr->link;
    ptr->link = temp;

    return temp;

}

int main() {
    struct node * tail=malloc(sizeof(struct node));
    tail->data = 10;
    tail->link = tail;

    tail = insert_begin(tail,20);

    return 0;
}
