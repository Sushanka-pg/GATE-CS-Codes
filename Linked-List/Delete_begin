#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node * link;
};

struct node * insert_end(struct node * ptr, int data){
    struct node * temp =malloc (sizeof(struct node));
    temp->data = data;
    temp->link =NULL;

    while(ptr->link != NULL){
        ptr = ptr->link ;
    }
    ptr->link = temp;

    return temp;
}

