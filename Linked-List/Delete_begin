struct node * del_begin(struct node * ptr){
    struct node * temp = ptr;
    ptr=ptr->link;

    free(temp);

    return ptr;
}

struct node * insert_k(struct node * ptr, int data , int pos){
        int count=0;
        struct node * head = ptr;
        struct node * temp = malloc(sizeof(struct node));
        temp->data = data;
        temp -> link = NULL;

        while(count < pos-1){
            count++;
            ptr = ptr->link;
        }
        temp->link = ptr->link;
        ptr->link = temp;

        return head;
}

