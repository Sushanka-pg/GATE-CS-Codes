#include <stdio.h>
#include <stdlib.h>

struct node {
    struct node * prev ;
    int data;
    struct node * next;
};

struct node * insert_at_begin(struct node * ptr , int data){
    struct node * temp = malloc(sizeof(struct node));
    temp->prev = NULL;
    temp->data = data;
    temp->next =NULL;
    
    temp->next = ptr;
    ptr->prev= temp;
    ptr=temp;

    return temp;
    
}

struct node * insert_at_end(struct node * ptr, int data){
    struct node * temp=malloc(sizeof(struct node));
    temp->prev = NULL;
    temp->data = data;
    temp->next =NULL;

    while(ptr->next !=NULL){
        ptr = ptr->next;
    }
    ptr->next = temp;
    temp->prev = ptr;
    return temp;
}

int main() {
    struct node * head = malloc(sizeof(struct node));
    head->prev = NULL;
    head->data = 10;
    head->next = NULL;

    struct node * current;
    current = head;
    current = insert_at_end(current,20);
    current = insert_at_end(current,30);
    current = insert_at_end(current,40);
    current = insert_at_end(current,50);

    head= insert_at_begin(head,05);


    current = head;
    while(current!=NULL){
        printf("%d \n", current->data);
        current = current->next;
    }


    return 0;
}
