struct node * delete_at_k(struct node * ptr,int pos){
    struct node * head =ptr;
    int count =1;
    while (count < pos && ptr->next!=NULL){
        ptr = ptr->next;
        count++;
    }
    ptr->prev->next = ptr->next;
    ptr->next->prev = ptr->prev;

    free(ptr);

    return head;
}

