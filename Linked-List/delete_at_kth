#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node * link;
};

struct node * insert_begin(struct node * ptr, int data){
    struct node * temp= malloc(sizeof(struct node));
    temp->data = data;
    temp->link = NULL;

    temp->link = ptr;
    ptr = temp;

    return ptr;
}

