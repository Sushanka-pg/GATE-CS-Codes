struct node * del_at_k(struct node * ptr, int pos){
    struct node * temp ;
    struct node * temp2;
    temp=temp2=ptr;
    int count=1;
    while(count < pos){
        count++;
        temp2 = temp;
        temp = temp-> link;
    }
    temp2->link = temp->link;
    temp->link = NULL;
    free(temp);

    return ptr;
}



