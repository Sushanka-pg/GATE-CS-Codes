// Bubble sort //
#include <stdio.h>

int main() {
    int a[10], i,n,temp;
    printf("Enter the size of the array");
    scanf("%d ", &n);
    printf("Enter the array elements \n");
    for(int i=0;i<n;i++){
        scanf("%d",&a[i]);
    }

    // Bubble sort

    for(i=0;i<n-1;i++){
            int key =0;
        for(int j=0;j<n-1-i;j++){
            if(a[j]>a[j+1]){
                temp=a[j];
                a[j]=a[j+1];
                a[j+1]=temp;
                key =1;
            }
        }
        if(key==0) break;
    }

    // Insertion sort 
    
    for(i=1;i<n;i++){
        int temp = a[i];
        int j = i-1;
        while(j>=0 && a[j]>temp){
            a[j+1]=a[j];
            j--;
        }a[j+1]=temp;
    }
    printf("The sorted array is:");
    for(i=0;i<n;i++){
        printf("%d \t",a[i]);
    }
    return 0;
}
